{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "bunx",
      "args": ["nx", "mcp"]
    },
    "github": {
      "type": "stdio",
      "command": "sh",
      "args": ["scripts/mcp/github-mcp.sh"]
    },
    "kaneo": {
      "type": "http",
      "url": "https://kaneo.jordylab.be/api/mcp"
    },
    "jordylab": {
      "type": "http",
      "url": "https://jordylab.be/mcp",
      "oauth": {
        "clientId": "jordylab-mcp-connector",
        "callbackPort": 19877
      }
    }
  }
}
