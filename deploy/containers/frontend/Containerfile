# Multi-stage build for jordylab-fe's "jordylab" app (Angular 21 / Nx 22, Bun).
# Built by CI for linux/amd64 only.
#
# Build context is the repo root, e.g.:
#   docker build -f deploy/containers/frontend/Containerfile -t jordylab-frontend .

# --- Build stage ---
FROM oven/bun:1 AS build
WORKDIR /workspace

COPY jordylab-fe/package.json jordylab-fe/bun.lock ./
RUN bun install --frozen-lockfile

COPY jordylab-fe/ ./
RUN bunx nx build jordylab --configuration=production

# --- Runtime stage ---
FROM nginx/docker-nginx-unprivileged:1.29-alpine AS runtime
COPY --from=build /workspace/dist/apps/jordylab /usr/share/nginx/html
COPY deploy/containers/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

LABEL org.opencontainers.image.title="jordylab-frontend"
LABEL org.opencontainers.image.source="https://github.com/jordy-swinnen/JordyLab"
# org.opencontainers.image.licenses is set once the licence text lands (see US7, T060).
