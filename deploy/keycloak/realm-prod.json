{
  "realm": "jordylab",
  "enabled": true,
  "loginTheme": "jordylab",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "defaultDefaultClientScopes": [
    "role_list",
    "saml_organization",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "organization"
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access to JordyLab: FNA, Settings and Game Catalog administration. Includes every JordyLab role",
        "composite": true,
        "composites": {
          "realm": ["guest", "app-gamecatalog", "gamecatalog-scanner"]
        }
      },
      {
        "name": "guest",
        "description": "Approved person (spec 014). App access is granted per app, for example app-gamecatalog"
      },
      {
        "name": "app-gamecatalog",
        "description": "Granted per person by the admin: Game Catalog read, chat, marks and ROM status (spec 014)"
      },
      {
        "name": "gamecatalog-scanner",
        "description": "Required for the scan client to POST /api/gamecatalog/ingest/scan and /check"
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "gamecatalog-script",
      "roles": [
        "gamecatalog-scanner"
      ]
    },
    {
      "clientScope": "offline_access",
      "roles": [
        "offline_access"
      ]
    }
  ],
  "clientScopeMappings": {
    "gamecatalog-script": [
      {
        "client": "gamecatalog-script",
        "roles": [
          "gamecatalog-scanner"
        ]
      }
    ],
    "realm-management": [
      {
        "client": "jordylab-backend",
        "roles": ["view-users", "manage-users", "view-realm", "view-clients"]
      }
    ]
  },
  "clients": [
    {
      "clientId": "jordylab-host",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://${PRODUCTION_DOMAIN}/*"
      ],
      "webOrigins": [
        "https://${PRODUCTION_DOMAIN}"
      ],
      "rootUrl": "https://${PRODUCTION_DOMAIN}",
      "baseUrl": "https://${PRODUCTION_DOMAIN}",
      "attributes": {
        "post.logout.redirect.uris": "https://${PRODUCTION_DOMAIN}/*"
      }
    },
    {
      "clientId": "gamecatalog-script",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      }
    },
    {
      "clientId": "jordylab-backend",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "${KEYCLOAK_BACKEND_CLIENT_SECRET}"
    }
  ],
  "users": [
    {
      "username": "service-account-jordylab-backend",
      "enabled": true,
      "serviceAccountClientId": "jordylab-backend",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users", "view-realm", "view-clients"]
      }
    }
  ]
}
