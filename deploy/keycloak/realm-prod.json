{
  "realm": "jordylab",
  "enabled": true,
  "loginTheme": "jordylab",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1800,
  "defaultDefaultClientScopes": [
    "role_list",
    "saml_organization",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "organization"
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access to JordyLab: FNA, Settings and Game Catalog administration. Includes every JordyLab role except the CI-only mobile-release-publisher",
        "composite": true,
        "composites": {
          "realm": ["guest", "gamecatalog-scanner"]
        }
      },
      {
        "name": "guest",
        "description": "Game Catalog read and chat access only"
      },
      {
        "name": "gamecatalog-scanner",
        "description": "Required for the scan client to POST /api/gamecatalog/ingest/scan and /check"
      },
      {
        "name": "mobile-release-publisher",
        "description": "Publish Android releases via POST /api/mobile/releases — CI identity only (spec 007 FR-004)"
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "gamecatalog-script",
      "roles": ["gamecatalog-scanner"]
    },
    {
      "clientScope": "offline_access",
      "roles": ["offline_access"]
    },
    {
      "client": "mobile-release-ci",
      "roles": ["mobile-release-publisher"]
    }
  ],
  "clientScopeMappings": {
    "gamecatalog-script": [
      {
        "client": "gamecatalog-script",
        "roles": ["gamecatalog-scanner"]
      }
    ],
    "realm-management": [
      {
        "client": "jordylab-backend",
        "roles": ["view-users", "manage-users", "view-roles"]
      }
    ]
  },
  "clients": [
    {
      "clientId": "jordylab-host",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": ["https://${PRODUCTION_DOMAIN}/*"],
      "webOrigins": ["https://${PRODUCTION_DOMAIN}"],
      "rootUrl": "https://${PRODUCTION_DOMAIN}",
      "baseUrl": "https://${PRODUCTION_DOMAIN}",
      "attributes": {
        "post.logout.redirect.uris": "https://${PRODUCTION_DOMAIN}/*"
      }
    },
    {
      "clientId": "gamecatalog-script",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": ["offline_access"],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      }
    },
    {
      "clientId": "jordylab-backend",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "${KEYCLOAK_BACKEND_CLIENT_SECRET}"
    },
    {
      "clientId": "jordylab-mobile",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://${PRODUCTION_DOMAIN}/mobile/callback"],
      "webOrigins": ["https://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PRODUCTION_DOMAIN}/mobile/*"
      }
    },
    {
      "clientId": "mobile-release-ci",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "${MOBILE_RELEASE_CI_CLIENT_SECRET}",
      "description": "CI-only service account that publishes Android releases (spec 007 D13)"
    }
  ],
  "users": [
    {
      "username": "service-account-jordylab-backend",
      "enabled": true,
      "serviceAccountClientId": "jordylab-backend",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users", "view-roles"]
      }
    },
    {
      "username": "service-account-mobile-release-ci",
      "enabled": true,
      "serviceAccountClientId": "mobile-release-ci",
      "realmRoles": ["mobile-release-publisher"]
    }
  ]
}
