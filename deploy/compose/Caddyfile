# Public routes for jordylab.be (spec 020, contracts/public-routes.md, research R2). Caddy is the only
# service that publishes ports. Plain HTTP is redirected to HTTPS, and the certificate is issued through
# the HTTP-01 challenge on port 80.
{
	email jordy.swinnen@pm.me
}

jordylab.be {
	# A Caddy path matcher is exact unless it ends in *, so each prefix route lists the bare path and /*.
	@backend path /api /api/*
	handle @backend {
		reverse_proxy backend:8080
	}

	# The Claude connector (spec 021, research R4): the MCP endpoint and the protected resource metadata Claude reads first.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy backend:8080
	}

	@protected_resource path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @protected_resource {
		reverse_proxy backend:8080
	}

	@keycloak path /auth/realms/jordylab /auth/realms/jordylab/* /auth/resources /auth/resources/* /auth/.well-known /auth/.well-known/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	# The /ntfy prefix is stripped before forwarding, as the Gateway's ReplacePrefixMatch did. handle_path takes
	# one pattern only, so the strip is written out with a named matcher that lists both forms.
	@ntfy path /ntfy /ntfy/*
	handle @ntfy {
		uri strip_prefix /ntfy
		reverse_proxy ntfy:80
	}

	# Everything else, including near misses such as /apis and /auth/admin, goes to the Angular application.
	handle {
		reverse_proxy frontend:8080
	}
}
