# Public routes for jordylab.be (spec 020, contracts/public-routes.md, research R2). Caddy is the only
# service that publishes ports. Plain HTTP is redirected to HTTPS, and the certificate is issued through
# the HTTP-01 challenge on port 80.
{
	email jordy.swinnen@pm.me
}

jordylab.be {
	# A Caddy path matcher is exact unless it ends in *, so each prefix route lists the bare path and /*.
	@backend path /api /api/* /webauthn /webauthn/* /login/webauthn
	handle @backend {
		reverse_proxy backend:8080
	}

	# The MCP connector's authorization server and its metadata (spec 021, contracts/oauth-authorization-server.md).
	@oauth path /oauth2 /oauth2/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/*
	handle @oauth {
		reverse_proxy backend:8080
	}

	# The connector endpoint and the protected resource metadata Claude reads before signing in (RFC 9728).
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy backend:8080
	}

	@protected_resource path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @protected_resource {
		reverse_proxy backend:8080
	}

	# The /ntfy prefix is stripped before forwarding, as the Gateway's ReplacePrefixMatch did. handle_path takes
	# one pattern only, so the strip is written out with a named matcher that lists both forms.
	# The old identity-provider paths are gone: never fall through to the SPA. A handle is needed
	# because Caddy orders a bare respond after handle, where the fallback would win.
	@oldAuth path /auth /auth/*
	handle @oldAuth {
		respond 404
	}

	@ntfy path /ntfy /ntfy/*
	handle @ntfy {
		uri strip_prefix /ntfy
		reverse_proxy ntfy:80
	}

	# Everything else, including near misses such as /apis, goes to the Angular application.
	handle {
		reverse_proxy frontend:8080
	}
}

# Kaneo, the backlog (spec 022). Its own address, served over HTTPS like the application. Caddy does not wait for
# Kaneo to start: while the container is down, only this address answers with a bad gateway.
kaneo.jordylab.be {
	reverse_proxy kaneo:5173
}
