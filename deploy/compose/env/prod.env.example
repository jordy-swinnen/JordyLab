# Variable names for the production environment file (spec 020, contracts/env-contract.md).
# The real file is rendered by scripts/render-env.sh and written to /opt/jordylab/env/prod.env (mode 600).
# Values stay empty here. Never put a value in this file.
#
# Used by `docker compose config` to check that compose.yaml only uses names listed here.

# --- Backend ---
SPRING_PROFILES_ACTIVE=
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
IDENTITY_BOOTSTRAP_ADMIN_USERNAME=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=
JORDYLAB_CORS_ALLOWED_ORIGINS=
JORDYLAB_APP_BASE_URL=
NTFY_BASE_URL=
NTFY_TOPIC=
NTFY_TOKEN=
LINEAR_API_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=
LANGFUSE_CAPTURE_CONTENT=
SPRINGDOC_API_DOCS_ENABLED=
SPRINGDOC_SWAGGER_UI_ENABLED=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
STEAM_WEB_API_KEY=
STEAM_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
THEGAMESDB_API_KEY=

# --- Keycloak ---
KC_DB_URL=
KC_DB_SCHEMA=
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_HOSTNAME=
KC_HTTP_RELATIVE_PATH=
KC_PROXY_HEADERS=
KC_HTTP_ENABLED=
KC_PROXY_TRUSTED_ADDRESSES=
PRODUCTION_DOMAIN=

# --- Postgres (superuser and pgBackRest) ---
POSTGRES_DB=
POSTGRES_SUPERUSER_PASSWORD=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=

# --- Release (exported by scripts/deploy-release.sh, not stored in this file) ---
# JORDYLAB_RELEASE is read by compose.yaml for the GHCR image tags.
