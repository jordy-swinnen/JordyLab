# Production Postgres for the Compose stack: the same Postgres 16 and pgvector image family as local
# development, plus pgBackRest for continuous archiving and point-in-time restore (spec 020, research R3).
# Built with the deploy/compose folder as the context, so the config below can be copied in.
# Pinned: the base image by digest (Postgres 16.15 with pgvector) and the pgBackRest package by version,
# so a rebuild cannot change the production Postgres or pgBackRest. To upgrade, change both values
# deliberately and rebuild. The digest is the MULTI-ARCH MANIFEST LIST (amd64 + arm64), so the same pin
# builds on the VPS (amd64) and the Mac (arm64); pinning a single-platform manifest broke the VPS build
# with `exec format error` (BUG-081, found in the cutover window 2026-11-03).
FROM pgvector/pgvector:pg16@sha256:0dd3149a06e4579a0d70d8fef9945636cd514005e7237deb27f9b67886f8dc4f
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends pgbackrest=2.60.0-1.pgdg12+1 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /var/lib/pgbackrest /var/log/pgbackrest /etc/pgbackrest \
 && chown -R postgres:postgres /var/lib/pgbackrest /var/log/pgbackrest
COPY pgbackrest/pgbackrest.conf /etc/pgbackrest/pgbackrest.conf
USER postgres
