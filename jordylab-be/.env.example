# Copy to .env and fill in real values. Never commit real values.
POSTGRES_USER=
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_BACKEND_SECRET=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NTFY_BASE_URL=
NTFY_TOPIC=
NTFY_TOKEN=
GAMECATALOG_ARTWORK_DIR=
STEAM_WEB_API_KEY=
STEAM_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# TheGamesDB player counts for console games (optional; the lookup is skipped without it)
THEGAMESDB_API_KEY=

# Langfuse tracing of AI calls (optional; no keys, no export)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Add prompts and answers to the traces (off by default)
LANGFUSE_CAPTURE_CONTENT=false
