{
  "name": "jordylab",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/jordylab/src",
  "tags": ["scope:shared", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/jordylab",
        "baseHref": "/",
        "browser": "apps/jordylab/src/main.ts",
        "tsConfig": "apps/jordylab/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/jordylab/public"
          }
        ],
        "styles": ["node_modules/@angular/cdk/overlay-prebuilt.css", "apps/jordylab/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/jordylab/src/environments/environment.ts",
              "with": "apps/jordylab/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "mobile-e2e": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": false,
          "fileReplacements": [
            {
              "replace": "apps/jordylab/src/environments/environment.ts",
              "with": "apps/jordylab/src/environments/environment.mobile-e2e.ts"
            }
          ]
        },
        "e2e": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": false,
          "fileReplacements": [
            {
              "replace": "apps/jordylab/src/environments/environment.ts",
              "with": "apps/jordylab/src/environments/environment.e2e.ts"
            }
          ]
        },
        "mobile": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/jordylab/src/environments/environment.ts",
              "with": "apps/jordylab/src/environments/environment.mobile.ts"
            }
          ],
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4200,
        "proxyConfig": "apps/jordylab/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "jordylab:build:production"
        },
        "development": {
          "buildTarget": "jordylab:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "jordylab:build:development",
        "staticFilePath": "dist/apps/jordylab/browser",
        "spa": true,
        "host": "0.0.0.0"
      }
    }
  }
}
