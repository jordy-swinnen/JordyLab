{
  "name": "jordylab-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/jordylab-mobile",
  "tags": ["scope:shared", "type:app"],
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx cap sync android",
        "cwd": "apps/jordylab-mobile"
      },
      "dependsOn": [{ "projects": "jordylab", "target": "build", "params": "forward" }]
    },
    "open-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx cap open android",
        "cwd": "apps/jordylab-mobile"
      }
    }
  }
}
