{
  "name": "jordylab-mobile-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Appium suite for what only breaks inside the installed Android app (spec 012). Its own package so Appium and WebdriverIO stay out of the main frontend lockfile and image.",
  "scripts": {
    "setup": "APPIUM_HOME=\"$PWD/.appium\" appium driver install --source=npm appium-uiautomator2-driver@8.7.0",
    "test:app": "wdio run wdio.conf.ts",
    "test:browser": "wdio run wdio.browser.conf.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "appium": "3.8.0",
    "typescript": "6.0.3",
    "webdriverio": "9.32.0"
  }
}
