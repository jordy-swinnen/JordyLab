{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3.6:27b-64k": {
          "name": "Qwen3.6 27B (64k ctx, local)",
          "limit": {
            "context": 58000,
            "output": 65536
          }
        }
      }
    }
  },
  "instructions": [".github/instructions/commits-and-pull-requests.instructions.md"],
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["bunx", "nx", "mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["sh", "scripts/mcp/github-mcp.sh"],
      "enabled": true
    },
    "kaneo": {
      "type": "remote",
      "url": "https://kaneo.jordylab.be/api/mcp",
      "enabled": true
    },
    "jordylab": {
      "type": "remote",
      "url": "https://jordylab.be/mcp",
      "enabled": true,
      "oauth": {
        "clientId": "jordylab-mcp-connector",
        "callbackPort": 19876,
        "scope": "jordylab.mcp"
      }
    }
  },
  "agent": {
    "planner": {
      "mode": "primary",
      "description": "SpecKit: constitution, specify, clarify, plan, tasks. Use for work where an error propagates into every later step.",
      "model": "opencode-go/claude-haiku-5-5",
      "variant": "xhigh"
    },
    "reviewer": {
      "mode": "primary",
      "description": "SpecKit: analyze, converge. Different model creator than the planner for an independent review.",
      "model": "opencode-go/mimo-v2.6-flash"
    },
    "worker": {
      "mode": "primary",
      "description": "SpecKit: implement, checklist, taskstoissues. Cheap, fast, very high request quota.",
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "max"
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "plan": {
      "model": "opencode-go/glm-5.2"
    }
  }
}
