{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3.6:27b-64k": {
          "name": "Qwen3.6 27B (64k ctx, local)",
          "limit": {
            "context": 58000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["bunx", "nx", "mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    }
  },
  "agent": {
    "sdd-plan": {
      "mode": "primary",
      "model": "glm-5.2",
      "permission": {
        "edit": {
          "*": "deny",
          "specs/**": "allow",
          ".specify/memory/**": "allow"
        },
        "bash": {
          "*": "ask",
          ".specify/scripts/bash/*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git rev-parse*": "allow"
        }
      }
    },
    "sdd-build": {
      "mode": "primary",
      "model": "ollama/qwen3.6:27b-64k"
    }
  }
}
