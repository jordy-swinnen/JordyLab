{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["bunx", "nx", "mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    }
  },
  "agent": {
    "sdd-plan": {
      "mode": "primary",
      "model": "z-ai/glm-5.2",
      "permission": { "edit": "allow", "bash": "allow" }
    },
    "sdd-build": {
      "mode": "primary",
      "model": "ollama/qwen3.6:27b",
      "permission": { "edit": "allow", "bash": "allow" }
    }
  }
}
